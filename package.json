{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE - Local AI Research & Build Studio",
  "workspaces": [
    "forge-frontend",
    "forge-desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=forge-frontend",
    "build": "npm run build --workspace=forge-frontend",
    "desktop": "npm run tauri dev --workspace=forge-desktop",
    "desktop:build": "npm run tauri build --workspace=forge-desktop"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
