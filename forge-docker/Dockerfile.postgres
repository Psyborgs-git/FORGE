FROM postgres:16

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    postgresql-server-dev-16 \
    libreadline-dev \
    zlib1g-dev \
    flex \
    bison \
    libxml2-dev \
    libxslt-dev \
    libssl-dev \
    libxml2-utils \
    xsltproc \
    cmake \
    pkg-config \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pgvector
RUN cd /tmp && \
    git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd / && rm -rf /tmp/pgvector

# Install Apache AGE 1.5.0 (PG16 compatible)
RUN cd /tmp && \
    git clone --branch PG16/v1.5.0 https://github.com/apache/age.git && \
    cd age && \
    make && \
    make install && \
    cd / && rm -rf /tmp/age

# Install TimescaleDB
RUN cd /tmp && \
    git clone --branch 2.16.1 https://github.com/timescale/timescaledb.git && \
    cd timescaledb && \
    ./bootstrap -DREGRESS_CHECKS=OFF && \
    cd build && make && make install && \
    cd / && rm -rf /tmp/timescaledb

# Install pgai
RUN cd /tmp && \
    git clone https://github.com/timescale/pgai.git && \
    cd pgai && \
    make && \
    make install && \
    cd / && rm -rf /tmp/pgai

# pg_trgm is built-in, no installation needed

# Copy initialization script
COPY init.sql /docker-entrypoint-initdb.d/

# Set shared_preload_libraries for TimescaleDB and AGE
RUN echo "shared_preload_libraries = 'timescaledb,age'" >> /usr/share/postgresql/postgresql.conf.sample

# Expose PostgreSQL port
EXPOSE 5432
